# Stripe wallet API (this plugin owns Checkout + ledger)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
URL=http://localhost:3030
VITE_API_BASE=http://localhost:3030

# Embedded Checkout mounts in this plugin's own page, so the browser needs the
# publishable key too.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

ALLOW_DEV_CREDIT=true
VITE_ALLOW_DEV_CREDIT=true
WALLET_STORE_PATH=

# Older Stripe accounts still use the pre-2026-03-25 enum ('embedded').
# STRIPE_CHECKOUT_UI_MODE=embedded

# Production site (separate from game library):
# https://sigma-wallet-plugin.netlify.app
